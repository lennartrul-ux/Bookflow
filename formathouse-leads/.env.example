# Kopieer naar .env en vul in wat je hebt. Alles is optioneel: zonder sleutel valt de
# tool terug op een alternatief of laat hij het veld op 'onbekend' staan.

# Werkgebied: vlaanderen (standaard) | belgie (+ Brussel) | be_nl (+ Nederland)
# Vlaanderen = postcodes 1500–3999 en 8000–9999.
REGIO=vlaanderen

# ── Fase 1: Discovery ────────────────────────────────────────────────
# Leeg = OpenStreetMap (gratis, geen sleutel, wel zonder Google-reviews/rating).
GOOGLE_PLACES_API_KEY=

# ── Fase 2: Verrijking via bedrijfswebsites ──────────────────────────
# Vermeld een contactadres of URL in de user-agent (netiquette voor crawlers).
CRAWL_USER_AGENT=FormatHouseResearch/0.1 (+https://JOUW-DOMEIN)
CRAWL_DELAY_SECONDS=3

# ── Fase 3: Social (alleen officiële Meta API's) ──────────────────────
# Leeg = Instagram-cijfers en advertenties blijven 'onbekend'.
META_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0

# ── Fase 4–5: Claude API (scoring + teksten) ─────────────────────────
# Leeg = regelgebaseerde score en vaste sjabloonteksten.
ANTHROPIC_API_KEY=
# Standaard claude-opus-5-5. Goedkoper alternatief: claude-sonnet-5-5.
CLAUDE_MODEL=claude-opus-5-5

# ── Fase 5: E-mail outreach (gebruik een APART outreach-domein!) ──────
# Leeg = alleen concepten; er wordt niets verstuurd.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OUTREACH_FROM_NAME=The Format House
OUTREACH_FROM_EMAIL=
# Adres voor uitschrijvingen (standaard = OUTREACH_FROM_EMAIL)
OUTREACH_UNSUBSCRIBE_EMAIL=
# Handtekening; gebruik \n voor een nieuwe regel
OUTREACH_SIGNATURE=Team The Format House\nwww.JOUW-DOMEIN.be
# Max. mails per dag (hard begrensd op 30)
OUTREACH_DAILY_MAX=25

# ── Fase 5: Instagram-wachtrij ────────────────────────────────────────
# Max. nieuwe items per dag (hard begrensd op 15)
IG_DAILY_MAX=15

# ── Paden ────────────────────────────────────────────────────────────
LEADS_DB=leads.db
OUTPUT_DIR=output
