# ── Fase 1: Discovery ────────────────────────────────────────────────
# Google Cloud-project → "Places API (New)" activeren → API-sleutel aanmaken
# (beperk de sleutel tot de Places API). Zie README.
GOOGLE_PLACES_API_KEY=

# Werkgebied: vlaanderen (standaard) | belgie (+ Brussel) | be_nl (+ Nederland)
# Vlaanderen = postcodes 1500–3999 en 8000–9999.
REGIO=vlaanderen

# ── Fase 2: Verrijking ───────────────────────────────────────────────
# KvK API (alleen nodig als REGIO=be_nl), via developers.kvk.nl. Leeg = KvK-velden 'onbekend'.
KVK_API_KEY=
# User-agent en rustige crawlsnelheid voor bedrijfswebsites (robots.txt wordt altijd gerespecteerd)
CRAWL_USER_AGENT=FormatHouseResearch/0.1 (+https://JOUW-DOMEIN/bot)
CRAWL_DELAY_SECONDS=3

# ── Fase 3: Social (alleen officiële Meta API's) ──────────────────────
META_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=

# ── Fase 4: Scoring ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# ── Fase 5: E-mail outreach (apart outreach-domein!) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OUTREACH_FROM_NAME=The Format House
OUTREACH_FROM_EMAIL=
OUTREACH_DAILY_MAX=25

# ── Paden ────────────────────────────────────────────────────────────
LEADS_DB=leads.db
OUTPUT_DIR=output
